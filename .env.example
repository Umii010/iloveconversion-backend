# Server
NODE_ENV=production
PORT=3000

# Frontend URL (for reset links, redirects)
FRONTEND_URL=https://yoursite.com

# CORS – comma-separated list of allowed origins
# Required in production to allow your frontend
CORS_ORIGINS=https://yoursite.com,https://www.yoursite.com

# Session
SESSION_SECRET=change-this-to-a-random-secret-in-production

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=iloveconversion
DB_USER=root
DB_PASSWORD=

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_MONTHLY_PRICE_ID=price_xxx
STRIPE_YEARLY_PRICE_ID=price_xxx

# Mail (optional – for forgot password)
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=noreply@yoursite.com
MAIL_PASSWORD=xxx
MAIL_FROM_ADDRESS=noreply@yoursite.com
MAIL_FROM_NAME="iLoveConversion"
